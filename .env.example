# ==============================================================================
# Nutri Milk Guard - Environment Configuration
# Copy this file to '.env' and adjust settings as appropriate.
# NEVER commit private credentials or your actual '.env' to version control.
# ==============================================================================

# Flask Configuration
FLASK_APP=run.py
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=change-this-to-a-secure-random-secret-key-for-production

# Firebase Project Configuration
# Target Firebase Project ID: milk-monitoring-4cb97
FIREBASE_PROJECT_ID=milk-monitoring-4cb97
FIREBASE_DATABASE_URL=https://milk-monitoring-4cb97-default-rtdb.asia-southeast1.firebasedatabase.app/

# Firebase Admin SDK Credentials
# Path to service account key JSON file (downloaded from Firebase Console -> Project Settings -> Service Accounts)
# If omitted or file not found, the application gracefully connects in secure read-only REST mode.
GOOGLE_APPLICATION_CREDENTIALS=./secrets/serviceAccountKey.json

# Sensor Monitoring & Database Paths
# The ESP32 writes the latest reading directly to milk_monitor/current
DEFAULT_DB_PATH=milk_monitor/current

# Live Data Polling & Stale Detection
# Polling interval in seconds (used for background listener / sync worker)
UPDATE_POLL_INTERVAL=3.0

# Stale data timeout in seconds (readings older than this trigger a stale warning)
STALE_DATA_TIMEOUT=45

# Server Port and Host
HOST=127.0.0.1
PORT=5000
